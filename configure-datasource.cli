batch

# 1. Enregistrer le module/driver PostgreSQL à partir du JAR déployé
/subsystem=datasources/jdbc-driver=postgres:add( \
    driver-name=postgres, \
    driver-module-name=org.postgresql, \
    driver-class-name=org.postgresql.Driver \
)

# 2. Créer la DataSource MonitoringDS
data-source add \
    --name=MonitoringDS \
    --jndi-name=java:jboss/datasources/MonitoringDS \
    --driver-name=postgresql-42.7.3.jar \
    --connection-url=jdbc:postgresql://postgres_db:5432/monitoring_test \
    --user-name=monitoring_app \
    --password=monitoring_pass_2026 \
    --valid-connection-checker-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker \
    --exception-sorter-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter \
    --enabled=true

run-batch
