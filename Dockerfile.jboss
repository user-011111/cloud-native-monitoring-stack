FROM quay.io/wildfly/wildfly:26.1.3.Final-jdk11

USER root

# Copier le driver, l'application et notre propre fichier standalone.xml corrigé
COPY postgresql-42.7.3.jar /opt/jboss/wildfly/standalone/deployments/
COPY monitor-test.war /opt/jboss/wildfly/standalone/deployments/ROOT.war
COPY standalone.xml /opt/jboss/wildfly/standalone/configuration/standalone.xml

# Ajuster les permissions
RUN chown -R jboss:jboss /opt/jboss/wildfly/standalone/deployments/ /opt/jboss/wildfly/standalone/configuration/standalone.xml

USER jboss

EXPOSE 8080 9990

CMD ["/opt/jboss/wildfly/bin/standalone.sh", "-b", "0.0.0.0", "-bmanagement", "0.0.0.0"]